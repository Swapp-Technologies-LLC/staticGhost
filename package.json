{
  "name": "staticghost",
  "version": "1.0.0",
  "description": "StaticGhost: Desktop interface to run Ghost locally via Docker and export to clean, SEO-optimized static HTML pages.",
  "main": "main.js",
  "scripts": {
    "start": "npx electron .",
    "test": "node test-suite.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "ghost",
    "static-site-generator",
    "github-pages",
    "electron",
    "cloudflare-tunnel",
    "affiliate-marketing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "crypto-js": "^4.2.0",
    "express": "^4.19.2",
    "mime-types": "^2.1.35",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "solutions.swapp.staticghost",
    "productName": "StaticGhost",
    "win": {
      "target": "nsis",
      "icon": "src/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "StaticGhost"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "lib/**/*",
      "src/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
